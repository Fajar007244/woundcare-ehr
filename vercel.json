{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "api": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "api/index.js"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "installCommand": "npm install",
      "rewrites": [
        {
          "source": "/((?!api/).*)",
          "destination": "/index.html"
        }
      ]
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/((?!api/).*)",
      "destination": { "service": "web" }
    }
  ]
}