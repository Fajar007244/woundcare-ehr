{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "api": {
      "root": ".",
      "runtime": "node"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/((?!api/).*)",
      "destination": { "service": "web" }
    }
  ]
}