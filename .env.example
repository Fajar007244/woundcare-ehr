# ============================================================
#  Salin berkas ini menjadi `.env` lalu isi nilainya.
#  Di Vercel: Settings > Environment Variables > tambahkan
#              DATABASE_URL (tanpa perlu berkas .env di sana).
# ============================================================

# KONEKSI POSTGRESQL (dari Supabase)
# Supabase > Settings > Database > Connection string > URI
# Untuk serverless pakai yang berlabel "pooler" / port 6543.
#
#   postgresql://postgres:PASSWORD@db.XXXXXXXX.supabase.co:6543/postgres
#
# Perhatikan: password di URL harus di-URL-encode kalau mengandung
# karakter khusus seperti @ : / ? # [ ] %.
DATABASE_URL=

# Token Supabase (opsional — hanya untuk Storage, belum dipakai di versi ini)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=